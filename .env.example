# Public URL of the separately deployed API; exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend-only settings; never expose these in the frontend bundle.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aet_ai
SESSION_SECRET=replace-with-a-long-random-secret
SUMOPOD_API_KEY=
APP_ORIGIN=http://localhost:3000

# Adaptive Intelligence Orchestrator V2 (opt-in; legacy remains default)
AI_ROUTER_V2=false
AI_SEMANTIC_CLASSIFIER=false
# Optional operator kill-switch for configured Sumopod model IDs (comma-separated)
SUMOPOD_DISABLED_MODELS=

# Phase 2 — deterministic prompt preparation (preserves user wording; no extra LLM call)
AI_PROMPT_PREPARATION=false

# Phase 3 adaptive multi-model orchestration (opt-in; complex non-fast tasks only)
AI_MULTI_MODEL_ORCHESTRATION=false

# Phase 4 — domain-aware quality scoring and evidence-aware quality gate (adaptive pipeline only)
AI_QUALITY_EVALUATION=false
